# --- Papyrus -------------------------------------------------------------
# Runtime state. Laravel's own nested .gitignore files cover the contents, and
# these repeat it at the top so a stray file is ignored even if one of those is
# ever removed. 247 files live under storage/ on a working install and none of
# them belong in version control.
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# The runtime that packaging/runtime/stage-jre.php builds, and the install layout a probe or a
# packaged build assembles around it.
#
# The launcher deliberately refuses to fall back to a system JVM, so the JRE has to exist inside
# the install. That install is the repository root by default, which means a staged runtime is
# 179MB of third-party binaries sitting where `git add -A` will find them. One accidental add
# and the history carries them forever.
#
# The suwayomi/ directory here is the packaging layout's runtime, not the application's. Nothing
# in app/ reads from it.
/suwayomi/
/runtime/
# The assembled install that packaging/runtime/build-install.php produces. Roughly 400MB, of
# which the jar and the JRE are the great majority, and all of it derivable from one command.
#
# Named rather than blanket excluding /build/, because the sandbox gate lives there too and a
# blanket rule takes it with it. Git will not descend into an excluded directory, so once
# /build/ was excluded the gate existed only on the machine that wrote it: anyone who cloned this
# repository got no gate at all, and the gate is the only check that runs on a machine with
# nothing installed.
/build/install/
# What a sandbox run leaves behind. Readable from the host, useless in the repository.
/build/sandbox-results/
# The throwaway data directory build-install.php lays out beside the install, so it can ask the
# launcher whether it can configure itself. Discarded by the build, but not by git if it is killed
# midway, and it holds a real .env with a generated APP_KEY.
/build/.build-probe/
# A scratch data directory the launcher is pointed at while health and supervisor behaviour is
# exercised by hand. It holds a database, logs and a lock file, none of which belong in a
# repository, and it appears the first time anyone runs the launcher from the repository root.
/build/health-data/
/build/health-start.*
# Where the staging scripts put things when pointed somewhere other than the repository root.
# 179MB of Temurin binaries and a CA bundle, which is the same hazard as /build/ and for the same
# reason: one `git add -A` from a permanent copy of a third-party distribution.
/.staging-test/

# Local tooling output: browser-gate screenshots and scratch scripts. The probes
# under .tools/suwayomi/ are kept outside this repository on purpose, because
# several of them carry a local seed account's credentials.
/.openchamber
/.openchamber/
/.zcode

# Process logs written by the three services the notes tell you to start by
# hand. They are per-developer runtime output, and vite.log in particular names
# the port the dev server happened to pick. suwayomi-probe.log is the same
# thing from an ad-hoc start, which is why the pattern is a glob rather than
# one more literal name.
/queue.log
/vite.log
/vite.err.log
/suwayomi*.log
/suwayomi*.err

# Local environment overrides and editor droppings that Laravel's defaults miss
/.env.*
!/.env.example
/.phpunit.cache/
/Thumbs.db

# Backups other reader apps export, and anything unpacked out of one.
#
# Two reasons, and the second is the one that bites. These are a reader's own library: what
# they follow, how far through they are, and what they have downloaded. Not something to
# commit to a public repository even by accident.
#
# And they are large. A Tachimanga .tmb measured 39.4MB on this machine, and it holds a 113MB
# SQLite file inside it, so one of these in the repository root is a permanent multi-megabyte
# blob that `git add -A` will pick up silently, because a file being untracked is not the same
# thing as a file being ignored.
#
# The extensions are the export formats the import work targets. .tmb is Tachimanga,
# .tachibk is Mihon and the Tachiyomi forks, .proto.gz is the same content uncompressed,
# .aib is Aidoku, .pas4 is Paperback, .backup is Mangayomi.
*.tmb
*.tachibk
*.proto.gz
*.aib
*.pas4
*.backup
