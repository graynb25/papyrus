# --- Papyrus -------------------------------------------------------------
# Runtime state. Laravel's own nested .gitignore files cover the contents, and
# these repeat it at the top so a stray file is ignored even if one of those is
# ever removed. 247 files live under storage/ on a working install and none of
# them belong in version control.
/storage/framework/cache/*
!/storage/framework/cache/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/storage/app/private/*
!/storage/app/private/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore

# The runtime that packaging/runtime/stage-jre.php builds, and the install layout a probe or a
# packaged build assembles around it.
#
# The launcher deliberately refuses to fall back to a system JVM, so the JRE has to exist inside
# the install. That install is the repository root by default, which means a staged runtime is
# 179MB of third-party binaries sitting where `git add -A` will find them. One accidental add
# and the history carries them forever.
#
# The suwayomi/ directory here is the packaging layout's runtime, not the application's. Nothing
# in app/ reads from it.
/suwayomi/
/runtime/
# Scratch directories a probe or an experiment leaves in the repository root.
#
# Added after one of my own probes left a generated .env with a real APP_KEY sitting untracked
# here. It was never committed, and nothing in the project creates it, so the rule exists purely
# so that the next scratch directory is not one `git add .` away from a key and a database path
# going into the repository.
/.tools/
# The assembled install that packaging/runtime/build-install.php produces. Roughly 400MB, of
# which the jar and the JRE are the great majority, and all of it derivable from one command.
#
# Named rather than blanket excluding /build/, because the sandbox gate lives there too and a
# blanket rule takes it with it. Git will not descend into an excluded directory, so once
# /build/ was excluded the gate existed only on the machine that wrote it: anyone who cloned this
# repository got no gate at all, and the gate is the only check that runs on a machine with
# nothing installed.
/build/install/
# The installer that packaging/installer/build-installer.php compiles. Around 600MB, and it is the
# assembled install with the whole payload run through LZMA2, so it is both larger and less useful
# in a repository than the install directory it came from.
#
# Named separately rather than folded into the /build/install rule above, because the two are
# produced by different commands and somebody debugging why the installer is stale needs to be able
# to delete one and keep the other.
/build/dist/
# What a sandbox run leaves behind. Readable from the host, useless in the repository.
/build/sandbox-results/
# What a manual sandbox session leaves behind: a screenshot every ten seconds, a CSV index, and
# installer hashes. Readable from the host, useless in the repository.
/build/manual-sandbox-results/
# The throwaway data directory build-install.php lays out beside the install, so it can ask the
# launcher whether it can configure itself. Discarded by the build, but not by git if it is killed
# midway, and it holds a real .env with a generated APP_KEY.
/build/.build-probe/
# A scratch data directory the launcher is pointed at while health and supervisor behaviour is
# exercised by hand. It holds a database, logs and a lock file, none of which belong in a
# repository, and it appears the first time anyone runs the launcher from the repository root.
/build/health-data/
/build/health-start.*
# The data directory that running the launcher out of build/install creates, because a portable
# install keeps its data beside itself rather than in %LOCALAPPDATA%. Running it on 2026-10-15
# left 1217 untracked entries here including a database.sqlite, a Suwayomi .mv.db and a real .env
# with a generated APP_KEY, none of which belongs in a repository and all of which a `git add -A`
# would have taken. The same class as health-data above, and ignored for the same reason.
#
# It is also the path DataLocationTest uses as its rejected candidate, so a test here fails if
# anyone runs the install. That test now builds its own, but the collision is worth remembering
# before adding another one that reaches outside its own scratch directory.
/build/papyrus-data/
# The backups folder the checkout's own backups page reads. BackupLibrary::forThisInstall() resolves
# it as dirname(database)/backups, so on this checkout that is database/backups, and it is the same
# kind of thing as /build/papyrus-data above: both halves of a real backup, which is a reader's
# library, and an .env next to it in some configurations. Ignored here for the same reason rather
# than after the first `git add -A` takes one, which is what happened to the directory above.
/database/backups/
# What packaging/dev-workers.ps1 writes when it starts the queue and the scheduler for this
# checkout. They are a running process's output, so they change every few seconds and are of no
# interest to anybody reading the repository; the answer they would give is what `-Status` prints.
# Named rather than a blanket /build/dev-* so a stray directory there is still visible.
build/dev-queue.log
build/dev-queue.log.err
build/dev-scheduler.log
build/dev-scheduler.log.err
# Where the staging scripts put things when pointed somewhere other than the repository root.
# 179MB of Temurin binaries and a CA bundle, which is the same hazard as /build/ and for the same
# reason: one `git add -A` from a permanent copy of a third-party distribution.
/.staging-test/

# Local tooling output: browser-gate screenshots and scratch scripts. The probes
# under .tools/suwayomi/ are kept outside this repository on purpose, because
# several of them carry a local seed account's credentials.
/.openchamber
/.openchamber/
/.zcode

# Process logs written by the three services the notes tell you to start by
# hand. They are per-developer runtime output, and vite.log in particular names
# the port the dev server happened to pick. suwayomi-probe.log is the same
# thing from an ad-hoc start, which is why the pattern is a glob rather than
# one more literal name.
/queue.log
/vite.log
/vite.err.log
/suwayomi*.log
/suwayomi*.err

# Local environment overrides and editor droppings that Laravel's defaults miss
/.env.*
!/.env.example
/.phpunit.cache/
/Thumbs.db

# Backups other reader apps export, and anything unpacked out of one.
#
# Two reasons, and the second is the one that bites. These are a reader's own library: what
# they follow, how far through they are, and what they have downloaded. Not something to
# commit to a public repository even by accident.
#
# And they are large. A Tachimanga .tmb measured 39.4MB on this machine, and it holds a 113MB
# SQLite file inside it, so one of these in the repository root is a permanent multi-megabyte
# blob that `git add -A` will pick up silently, because a file being untracked is not the same
# thing as a file being ignored.
#
# The extensions are the export formats the import work targets. .tmb is Tachimanga,
# .tachibk is Mihon and the Tachiyomi forks, .proto.gz is the same content uncompressed,
# .aib is Aidoku, .pas4 is Paperback, .backup is Mangayomi.
*.tmb
*.tachibk
*.proto.gz
*.aib
*.pas4
*.backup

# Windows Sandbox configurations, resolved from the .wsb.template beside them. The guest has to be
# given an ABSOLUTE host folder, so the resolved file cannot avoid naming where the repository lives,
# and that is one machine's folder layout rather than project content. Tracked as templates; these
# are what resolve-wsb.ps1 writes and they are regenerated on demand.
build/sandbox/*.wsb
!build/sandbox/*.wsb.template

# Signing material. The private key and its certificate, made by packaging/signing/make-certificate.php.
#
# Never tracked, for the ordinary reason that a private key in a repository cannot be undone by deleting
# the file afterwards: every clone already has it and every mirror already has it.
#
# Inside the repository rather than under /build/dist/ on purpose. A clean of the output directory must
# not take the certificate with it, because losing this means the next build signs under a new identity
# and anybody who trusted the previous one is quietly given back a warning they had stopped seeing.
#
# The leading slash is required. Without it the rule matches a directory named .signing at any depth, and
# with this file's own indentation rules the difference is invisible unless you ask git rather than
# reading: an indented pattern is a literal path that happens to start with two spaces, so the rule
# matches nothing at all and looks identical to one that works.
/.signing/

# Bytecode caches for the Python gates under tools/. Python writes these on import, so the very act
# of running the gate creates one, and without this rule the first person to run it commits a .pyc
# by accident. Found the ordinary way: git add tools/ staged one.
__pycache__/
*.pyc