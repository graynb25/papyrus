APP_NAME=Papyrus
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Papyrus (self-hosted web manga reader) ---------------------------------
# Which deployment mode this install runs as.
#
# "single" is a one-reader install and does NOT leave sign-up open. It does open
# it until the install has its first account, because otherwise a fresh install
# has no way to make one at all: the only route to an account was the form the
# mode had just closed. The moment an account exists, /register answers 404 again.
#
# "shared" and "public" leave sign-up open permanently, and add per-user storage
# quotas. Promoting an install between them is this one setting, never a
# migration: every user-owned table carries user_id regardless.
PAPYRUS_DEPLOYMENT_MODE=single

# The address of this install's own reader.
#
# Written once, by the application, the first time somebody signs up. It is only
# ever a note about who the install is for: the login form uses it to pre-fill the
# address while the install is still unclaimed, so nobody has to retype it.
#
# It is deliberately not a password, and never will be. Laravel stores the
# password as a hash, so anything able to sign you in automatically would have to
# keep the PLAINTEXT on disk, readable by anything running as you and
# unrotatable. `php artisan users:create` avoids that by generating a password and
# printing it once. The database decides who exists; this is a convenience.
PAPYRUS_LOCAL_READER=

# The login screen's cover wall, built from the collection itself. Public
# endpoints serve those covers, so this only ever runs in "single" deployment
# mode, where the library has one owner. Set to false and the login page falls
# back to generative art and never asks the server for a cover.
PAPYRUS_SHOWCASE_ENABLED=true

# Suwayomi must be bound to loopback. Its CORS reflects any origin with
# credentials, and AuthMode.NONE hands Admin(1) to every caller.
SUWAYOMI_URL=http://127.0.0.1:4567
SUWAYOMI_GRAPHQL_PATH=/api/graphql

# Path the app serves Suwayomi page images from. Every image streams through a
# Laravel route: Herd has no per-path server block, so PHP is in the image path
# by design (AD-3 in docs/ENGINEERING-NOTES.md).
SUWAYOMI_PUBLIC_PATH=/suwayomi

# Required only when Suwayomi runs with AuthMode.UI_LOGIN (recommended). Run
# `php artisan suwayomi:check` to see which mode you are on.
#
# USERNAME, despite the name. This is not Papyrus's own login, which is email
# only: Papyrus has no username column and Fortify is set to 'username' => 'email'.
# This is the credential you registered with Suwayomi, and Suwayomi calls it a
# username in both its API and its web UI.
#
# Measured on v2.3.2243 and again on v2.4.2366, because it is worth knowing:
#   - LoginInput has exactly two fields, `password` and `username`, both NON_NULL
#   - the mutation accepts `username` and refuses `email` with "a field name
#     'email' that is not defined for input object type 'LoginInput'"
#   - all 614 files in the bundled web UI label the field "Username", and no
#     email-flavoured login string appears anywhere in it
#
# If you ever do register Suwayomi with an email address, put that address here.
# The value is whatever you signed up with; the field name is the server's.
SUWAYOMI_USERNAME=
# Generate one: php -r "echo bin2hex(random_bytes(24)), PHP_EOL;"
SUWAYOMI_PASSWORD=
# Folder the built-in local source reads from. Leave unset to disable it.
PAPYRUS_LOCAL_SOURCE_PATH=

# AniList reading-progress tracking. Both keys come from an application you
# create at anilist.co/settings/developer, and the redirect URI you register
# there must match this app's anilist.callback address exactly. Without them
# the Connections page in settings says what is missing instead of offering a
# button that cannot work. Lookups against AniList's public API need no key;
# only writing progress does.
ANILIST_OAUTH_CLIENT_ID=
ANILIST_OAUTH_CLIENT_SECRET=
# Only when the outside-facing address differs from APP_URL. Defaults to the
# anilist.callback route on APP_URL.
ANILIST_OAUTH_REDIRECT_URI=

SUWAYOMI_TIMEOUT=28
SUWAYOMI_CONNECT_TIMEOUT=5

# How many sources a search fans out to at once. The batch queues everything it is
# given, so this is the real cap: pending sources wait in the cache and each finishing
# job hands the next one on. Raise it and a search hits Suwayomi harder and holds the
# SQLite write lock longer, which is where the `database is locked` failures in the
# engineering notes come from. Lower it and a 82-source search takes proportionally
# longer to finish.
PAPYRUS_SEARCH_CONCURRENCY=8
